pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'REGISTRY', defaultValue: 'registry.example.com', description: 'Docker 镜像仓库地址，不要填写 http/https 协议')
        string(name: 'IMAGE_NAMESPACE', defaultValue: 'gulugulu', description: '镜像仓库命名空间')
        string(name: 'REGISTRY_CREDENTIALS_ID', defaultValue: 'docker-registry-credentials', description: 'Jenkins 用户名密码凭据 ID')
        string(name: 'GO_IMAGE', defaultValue: 'golang:1.24-bookworm', description: 'Go 构建基础镜像，可替换为公司镜像代理地址')
        string(name: 'RUNTIME_IMAGE', defaultValue: 'debian:bookworm-slim', description: '后端运行基础镜像，可替换为公司镜像代理地址')
        booleanParam(name: 'PUSH_LATEST', defaultValue: true, description: '同时推送 latest 标签')
        booleanParam(name: 'DEPLOY', defaultValue: false, description: '构建推送成功后在当前 Jenkins 节点部署')
        string(name: 'HOST_PORT', defaultValue: '8888', description: '部署时映射到宿主机的端口')
        string(name: 'DOCKER_NETWORK', defaultValue: 'gulugulu', description: '三个服务共同使用的 Docker 网络')
        string(name: 'BACKEND_CONFIG_FILE', defaultValue: '/opt/gulugulu/config/gulu.yaml', description: 'Jenkins 节点上的生产配置文件绝对路径')
        string(name: 'TZ', defaultValue: 'Asia/Shanghai', description: '后端容器时区')
    }

    environment {
        CONTAINER_NAME = 'gulugulu-api'
        TEST_IMAGE = "gulugulu-api-test:${BUILD_NUMBER}"
    }

    stages {
        stage('检出代码') {
            steps {
                checkout scm
                script {
                    def commit = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                    def branch = (env.BRANCH_NAME ?: 'detached').replaceAll(/[^A-Za-z0-9_.-]/, '-')
                    env.GIT_COMMIT_SHORT = commit
                    env.IMAGE_TAG = "${branch}-${env.BUILD_NUMBER}-${commit}"
                    env.IMAGE_REPO = "${params.REGISTRY}/${params.IMAGE_NAMESPACE}/gulugulu-api"
                    env.IMAGE_REF = "${env.IMAGE_REPO}:${env.IMAGE_TAG}"
                    env.LATEST_REF = "${env.IMAGE_REPO}:latest"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.IMAGE_TAG}"
                }
            }
        }

        stage('后端测试') {
            steps {
                sh '''
                    docker build --target test \
                      --build-arg "GO_IMAGE=$GO_IMAGE" \
                      --build-arg "RUNTIME_IMAGE=$RUNTIME_IMAGE" \
                      --tag "$TEST_IMAGE" \
                      --file gl-app/Dockerfile gl-app
                '''
            }
        }

        stage('构建后端镜像') {
            steps {
                sh '''
                    docker build \
                      --build-arg "GO_IMAGE=$GO_IMAGE" \
                      --build-arg "RUNTIME_IMAGE=$RUNTIME_IMAGE" \
                      --build-arg "VERSION=$IMAGE_TAG" \
                      --build-arg "GIT_COMMIT=$GIT_COMMIT_SHORT" \
                      --tag "$IMAGE_REF" \
                      --file gl-app/Dockerfile gl-app
                '''
            }
        }

        stage('验证 FFmpeg') {
            steps {
                sh '''
                    docker run --rm --entrypoint ffmpeg "$IMAGE_REF" -version
                    docker run --rm --entrypoint ffprobe "$IMAGE_REF" -version
                '''
            }
        }

        stage('推送镜像') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: params.REGISTRY_CREDENTIALS_ID,
                    usernameVariable: 'REGISTRY_USERNAME',
                    passwordVariable: 'REGISTRY_PASSWORD'
                )]) {
                    sh '''
                        trap 'docker logout "$REGISTRY" >/dev/null 2>&1 || true' EXIT
                        printf '%s' "$REGISTRY_PASSWORD" | docker login "$REGISTRY" \
                          --username "$REGISTRY_USERNAME" --password-stdin
                        docker push "$IMAGE_REF"
                        if [ "$PUSH_LATEST" = "true" ]; then
                          docker tag "$IMAGE_REF" "$LATEST_REF"
                          docker push "$LATEST_REF"
                        fi
                    '''
                }
            }
        }

        stage('部署后端') {
            when {
                expression { params.DEPLOY }
            }
            steps {
                sh '''
                    if [ ! -f "$BACKEND_CONFIG_FILE" ]; then
                      echo "生产配置文件不存在：$BACKEND_CONFIG_FILE" >&2
                      exit 1
                    fi

                    docker network inspect "$DOCKER_NETWORK" >/dev/null 2>&1 || docker network create "$DOCKER_NETWORK"
                    docker pull "$IMAGE_REF"
                    docker rm --force "$CONTAINER_NAME" >/dev/null 2>&1 || true
                    docker run --detach \
                      --name "$CONTAINER_NAME" \
                      --restart unless-stopped \
                      --stop-timeout 60 \
                      --network "$DOCKER_NETWORK" \
                      --publish "$HOST_PORT:8888" \
                      --env "TZ=$TZ" \
                      --volume "$BACKEND_CONFIG_FILE:/app/etc/gulu.yaml:ro" \
                      --volume gulugulu-media-tmp:/tmp/gulugulu-media \
                      "$IMAGE_REF"

                    for attempt in $(seq 1 18); do
                      status=$(docker inspect --format '{{.State.Health.Status}}' "$CONTAINER_NAME" 2>/dev/null || true)
                      [ "$status" = "healthy" ] && exit 0
                      [ "$status" = "unhealthy" ] && break
                      sleep 5
                    done
                    docker logs --tail 150 "$CONTAINER_NAME" || true
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            sh 'docker image rm --force "$TEST_IMAGE" >/dev/null 2>&1 || true'
            deleteDir()
        }
    }
}
