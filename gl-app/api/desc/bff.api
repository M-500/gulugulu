syntax = "v1"

info (
	title:   "Bff业务聚合层"
	desc:    "BFF"
	author:  "linlin"
	email:   "1978992154@qq.com"
	version: "v1"
)

import (
	"na/na.api"
	"media/media.api"
)

// No Need Login
@server (
	prefix: na/v1
	group:  na
)
service gulu {
	@doc "图片验证码"
	@handler captcha
	get /captcha returns (CaptchaResp)

	@doc "登录接口"
	@handler login
	post /user/login (LoginReq) returns (LoginResp)

	@doc "注册接口"
	@handler register
	post /user/register (RegisterReq) returns (RegisterResp)
}

// Need login
@server (
	prefix: api/v1
	group:  media
	jwt:    JwtAuth
)
service gulu {
	@doc "创建预签地址"
	@handler createUploadPresign
	post /media/upload/presign (CreateUploadPresignReq) returns (CreateUploadPresignResp)

	@doc "检查文件是否上传完成"
	@handler completeUpload
	post /media/upload/complete (CompleteUploadReq) returns (CompleteUploadResp)


	@doc "发布作品"
	@handler createMedia
	post /media/create (CreateMediaReq) returns (CreateMediaReep)
}

