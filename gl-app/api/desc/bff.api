syntax = "v1"

info (
	title:   "Bff业务聚合层"
	desc:    "BFF"
	author:  "linlin"
	email:   "1978992154@qq.com"
	version: "v1"
)

import (
	"app/app.api"
	"na/na.api"
	"media/media.api"
	"publish/publish.api"
	"user/user.api"
)

// No Need Login
@server (
	prefix: na/v1
	group:  na
)
service gulu {
	@doc "图片验证码"
	@handler captcha
	get /captcha returns (CaptchaResp)

	@doc "登录接口"
	@handler login
	post /user/login (LoginReq) returns (LoginResp)

	@doc "注册接口"
	@handler register
	post /user/register (RegisterReq) returns (RegisterResp)
}

// Current user profile
@server (
	prefix: api/v1
	group:  user
	jwt:    JwtAuth
)
service gulu {
	@doc "获取当前用户基本信息"
	@handler getUserInfo
	get /user/info returns (UserProfileResp)

	@doc "修改当前用户基本信息"
	@handler updateUserInfo
	put /user/info returns (UserProfileResp)

	@doc "获取当前用户资料"
	@handler getCurrentUser
	get /users/me returns (UserProfileResp)

	@doc "修改当前用户资料"
	@handler updateCurrentUser
	put /users/me (UpdateUserProfileReq) returns (UserProfileResp)

	@doc "上传当前用户头像"
	@handler uploadCurrentUserAvatar
	post /users/me/avatar (UploadUserAvatarReq) returns (UserProfileResp)
}

// App public api
@server (
	prefix: app/v1
	group:  app
)
service gulu {
	@doc "App首页推荐作品列表"
	@handler getRecommendWorkList
	get /recommend/works (RecommendWorkListReq) returns (RecommendWorkListResp)

	@doc "获取App用户公开资料"
	@handler getAppUserProfile
	get /users/:userId (AppUserProfileReq) returns (AppUserProfileResp)

	@doc "分页获取用户已发布的公开作品"
	@handler getUserPublishedWorkList
	get /users/:userId/works (UserPublishedWorkListReq) returns (UserPublishedWorkListResp)
}

// Need login
@server (
	prefix: api/v1
	group:  media
	jwt:    JwtAuth
)
service gulu {
	@doc "创建预签地址"
	@handler createUploadPresign
	post /media/upload/presign (CreateUploadPresignReq) returns (CreateUploadPresignResp)

	@doc "检查文件是否上传完成"
	@handler completeUpload
	post /media/upload/complete (CompleteUploadReq) returns (CompleteUploadResp)

	@doc "创建作品并提交媒体处理"
	@handler createWork
	post /works (CreateWorkReq) returns (CreateWorkResp)

	@doc "查询当前用户所有处理完成的作品"
	@handler getCreatorWorkList
	get /creator/works (CreatorWorkListReq) returns (CreatorWorkListResp)

	@doc "修改当前用户作品标题"
	@handler updateCreatorWorkTitle
	put /creator/works/:workId/title (UpdateCreatorWorkTitleReq) returns (CreatorWorkMutationResp)

	@doc "修改当前用户作品可见性"
	@handler updateCreatorWorkVisibility
	put /creator/works/:workId/visibility (UpdateCreatorWorkVisibilityReq) returns (CreatorWorkMutationResp)

	@doc "删除当前用户作品"
	@handler deleteCreatorWork
	delete /creator/works/:workId (WorkIdReq) returns (CreatorWorkMutationResp)

	@doc "查询作品详情"
	@handler getWork
	get /works/:workId (WorkIdReq) returns (WorkDetailResp)

	@doc "动态生成作品HLS播放清单"
	@handler getWorkPlaylist
	get /works/:workId/playlist (WorkIdReq)

	@doc "查询作品媒体处理、审核和发布状态"
	@handler getWorkStatus
	get /works/:workId/status (WorkIdReq) returns (WorkStatusResp)

	@doc "重试失败的媒体处理任务"
	@handler retryWork
	post /works/:workId/retry (WorkIdReq) returns (WorkStatusResp)

	@doc "审核作品"
	@handler auditWork
	post /works/:workId/audit (AuditWorkReq) returns (AuditWorkResp)

	@doc "查询审核中心作品列表"
	@handler getAuditWorkList
	get /audit/works (AuditWorkListReq) returns (AuditWorkListResp)

	@doc "查询审核作品详情"
	@handler getAuditWorkDetail
	get /audit/works/:workId (WorkIdReq) returns (AuditWorkDetailResp)

	@doc "动态生成审核作品HLS播放清单"
	@handler getAuditWorkPlaylist
	get /audit/works/:workId/playlist (WorkIdReq)
}

