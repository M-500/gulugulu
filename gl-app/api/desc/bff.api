syntax = "v1"

info (
	title:   "Bff业务聚合层"
	desc:    "BFF"
	author:  "linlin"
	email:   "1978992154@qq.com"
	version: "v1"
)

import (
	"na/na.api"
	"media/media.api"
	"publish/publish.api"
)

// No Need Login
@server (
	prefix: na/v1
	group:  na
)
service gulu {
	@doc "图片验证码"
	@handler captcha
	get /captcha returns (CaptchaResp)

	@doc "登录接口"
	@handler login
	post /user/login (LoginReq) returns (LoginResp)

	@doc "注册接口"
	@handler register
	post /user/register (RegisterReq) returns (RegisterResp)
}

// Need login
@server (
	prefix: api/v1
	group:  media
	jwt:    JwtAuth
)
service gulu {
	@doc "创建预签地址"
	@handler createUploadPresign
	post /media/upload/presign (CreateUploadPresignReq) returns (CreateUploadPresignResp)

	@doc "检查文件是否上传完成"
	@handler completeUpload
	post /media/upload/complete (CompleteUploadReq) returns (CompleteUploadResp)

	@doc "创建作品并提交媒体处理"
	@handler createWork
	post /works (CreateWorkReq) returns (CreateWorkResp)

	@doc "查询当前用户所有处理完成的作品"
	@handler getCreatorWorkList
	get /creator/works (CreatorWorkListReq) returns (CreatorWorkListResp)

	@doc "修改当前用户作品标题"
	@handler updateCreatorWorkTitle
	put /creator/works/:workId/title (UpdateCreatorWorkTitleReq) returns (CreatorWorkMutationResp)

	@doc "修改当前用户作品可见性"
	@handler updateCreatorWorkVisibility
	put /creator/works/:workId/visibility (UpdateCreatorWorkVisibilityReq) returns (CreatorWorkMutationResp)

	@doc "删除当前用户作品"
	@handler deleteCreatorWork
	delete /creator/works/:workId (WorkIdReq) returns (CreatorWorkMutationResp)

	@doc "查询作品详情"
	@handler getWork
	get /works/:workId (WorkIdReq) returns (WorkDetailResp)

	@doc "查询作品媒体处理、审核和发布状态"
	@handler getWorkStatus
	get /works/:workId/status (WorkIdReq) returns (WorkStatusResp)

	@doc "重试失败的媒体处理任务"
	@handler retryWork
	post /works/:workId/retry (WorkIdReq) returns (WorkStatusResp)

	@doc "审核作品"
	@handler auditWork
	post /works/:workId/audit (AuditWorkReq) returns (AuditWorkResp)
}

