syntax = "v1"

info(
    title: "用户实例"
    desc: "用户实例"
    author: "linlin"
    email: "1978992154@qq.com"
    version: "v1"
)


type User{
    Id  int64 `json:"id"`
    Email string `json:"email"`
    NickName string `json:"nickName"`
    Sex int64 `json:"sex"`
    Avatar string   `json:"avatar"`
}

type (
    UserProfileResp {
        UserId int64 `json:"userId"`
        Email string `json:"email"`
        NickName string `json:"nickName"`
        AvatarUrl string `json:"avatarUrl,optional"`
        Bio string `json:"bio"` // 用户简介
        Sex int64 `json:"sex"` // 0保密、1男、2女
        BothDay string `json:"bothDay"` // 用户生日，格式YYYY-MM-DD
    }

    UpdateUserProfileReq {
        NickName string `json:"nickName"`
        Bio string `json:"bio,optional"` // 用户简介
        Sex int64 `json:"sex,optional"` // 0保密、1男、2女
        BothDay string `json:"bothDay,optional"` // 用户生日，格式YYYY-MM-DD；空字符串表示清空
    }

    UpdateUserInfoReq {
    }

    UploadUserAvatarReq {
    }
)
