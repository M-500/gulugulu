syntax = "v1"

info(
    title: "作品发布接口"
    desc: "作品创建、处理状态和审核接口"
    author: "linlin"
    email: "1978992154@qq.com"
    version: "v1"
)

type (
    CreateWorkReq {
        Payload string `form:"payload"`
    }

    CreateWorkResp {
        WorkId int64 `json:"workId"`
        ProcessStatus string `json:"processStatus"`
        ReviewStatus string `json:"reviewStatus"`
        PublishStatus string `json:"publishStatus"`
    }

    WorkIdReq {
        WorkId int64 `path:"workId"`
    }

    WorkStatusResp {
        WorkId int64 `json:"workId"`
        ProcessStatus string `json:"processStatus"`
        ReviewStatus string `json:"reviewStatus"`
        PublishStatus string `json:"publishStatus"`
        Stage string `json:"stage"`
        Progress int64 `json:"progress"`
        Message string `json:"message"`
        FailureReason string `json:"failureReason"`
        ScheduledAt string `json:"scheduledAt,optional"`
        PublishedAt string `json:"publishedAt,optional"`
    }

    WorkAssetItem {
        MediaId int64 `json:"mediaId"`
        Role string `json:"role"`
        Sort int64 `json:"sort"`
        Url string `json:"url"`
    }

    WorkTopicItem {
        TopicId int64 `json:"topicId"`
        Name string `json:"name"`
    }

    CreatorWorkListReq {
        Page int64 `form:"page,optional"`
        PageSize int64 `form:"pageSize,optional"`
        Status string `form:"status,optional"`
        Keyword string `form:"keyword,optional"`
    }

    CreatorWorkListItem {
        WorkId int64 `json:"workId"`
        Type string `json:"type"`
        Title string `json:"title"`
        CoverUrl string `json:"coverUrl"`
        DurationMs int64 `json:"durationMs"`
        Visibility string `json:"visibility"`
        ReviewStatus string `json:"reviewStatus"`
        PublishStatus string `json:"publishStatus"`
        ReviewReason string `json:"reviewReason,optional"`
        ScheduledAt string `json:"scheduledAt,optional"`
        PublishedAt string `json:"publishedAt,optional"`
        CreatedAt string `json:"createdAt"`
    }

    CreatorWorkListResp {
        Total int64 `json:"total"`
        Page int64 `json:"page"`
        PageSize int64 `json:"pageSize"`
        AllCount int64 `json:"allCount"`
        PublishedCount int64 `json:"publishedCount"`
        ReviewingCount int64 `json:"reviewingCount"`
        RejectedCount int64 `json:"rejectedCount"`
        List []CreatorWorkListItem `json:"list"`
    }

    UpdateCreatorWorkTitleReq {
        WorkId int64 `path:"workId"`
        Title string `json:"title"`
    }

    UpdateCreatorWorkVisibilityReq {
        WorkId int64 `path:"workId"`
        Visibility string `json:"visibility"`
    }

    CreatorWorkMutationResp {
        WorkId int64 `json:"workId"`
        Updated bool `json:"updated"`
    }

    AuditWorkListReq {
        Page int64 `form:"page,optional"`
        PageSize int64 `form:"pageSize,optional"`
        Status string `form:"status,optional"`
        Type string `form:"type,optional"`
        Keyword string `form:"keyword,optional"`
    }

    AuditWorkListItem {
        WorkId int64 `json:"workId"`
        Type string `json:"type"`
        Title string `json:"title"`
        ContentExcerpt string `json:"contentExcerpt"`
        CoverUrl string `json:"coverUrl"`
        DurationMs int64 `json:"durationMs"`
        Visibility string `json:"visibility"`
        AuthorId int64 `json:"authorId"`
        AuthorName string `json:"authorName"`
        ReviewStatus string `json:"reviewStatus"`
        PublishStatus string `json:"publishStatus"`
        ReviewReason string `json:"reviewReason,optional"`
        SubmittedAt string `json:"submittedAt"`
        ReviewedAt string `json:"reviewedAt,optional"`
    }

    AuditWorkListResp {
        Total int64 `json:"total"`
        Page int64 `json:"page"`
        PageSize int64 `json:"pageSize"`
        PendingCount int64 `json:"pendingCount"`
        ApprovedCount int64 `json:"approvedCount"`
        RejectedCount int64 `json:"rejectedCount"`
        List []AuditWorkListItem `json:"list"`
    }

    AuditWorkDetailResp {
        WorkId int64 `json:"workId"`
        Type string `json:"type"`
        Title string `json:"title"`
        Content string `json:"content"`
        CoverUrl string `json:"coverUrl"`
        DurationMs int64 `json:"durationMs"`
        VideoPlaylist string `json:"videoPlaylist,optional"`
        Visibility string `json:"visibility"`
        Original bool `json:"original"`
        AuthorId int64 `json:"authorId"`
        AuthorName string `json:"authorName"`
        AuthorEmail string `json:"authorEmail"`
        ReviewStatus string `json:"reviewStatus"`
        PublishStatus string `json:"publishStatus"`
        ReviewReason string `json:"reviewReason,optional"`
        ScheduledAt string `json:"scheduledAt,optional"`
        SubmittedAt string `json:"submittedAt"`
        ReviewedAt string `json:"reviewedAt,optional"`
        Assets []WorkAssetItem `json:"assets"`
        Topics []WorkTopicItem `json:"topics"`
    }

    WorkDetailResp {
        WorkId int64 `json:"workId"`
        Type string `json:"type"`
        Title string `json:"title"`
        Content string `json:"content"`
        Visibility string `json:"visibility"`
        CollectionId int64 `json:"collectionId,optional"`
        Original bool `json:"original"`
        ProcessStatus string `json:"processStatus"`
        ReviewStatus string `json:"reviewStatus"`
        PublishStatus string `json:"publishStatus"`
        ScheduledAt string `json:"scheduledAt,optional"`
        PublishedAt string `json:"publishedAt,optional"`
        Assets []WorkAssetItem `json:"assets"`
        Topics []WorkTopicItem `json:"topics"`
    }

    AuditWorkReq {
        WorkId int64 `path:"workId"`
        Decision string `json:"decision"`
        Reason string `json:"reason,optional"`
    }

    AuditWorkResp {
        WorkId int64 `json:"workId"`
        ReviewStatus string `json:"reviewStatus"`
        PublishStatus string `json:"publishStatus"`
    }
)
